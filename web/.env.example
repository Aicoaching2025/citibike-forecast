# Server-only. Set these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapi_replace_me
DATABRICKS_WAREHOUSE_ID=replace_me
CITIBIKE_SCHEMA=workspace.citibike

# Set to 1 to serve built-in synthetic data (local development, previews, demos).
DEMO_MODE=0

# Optional: MapLibre style URL (default: OpenFreeMap Positron, free incl. commercial use, attribution shown).
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
